{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!pnpm-lock.yaml", "!index.html"] },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useTemplate": "off", "noNonNullAssertion": "off" },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useAriaPropsSupportedByRole": "off"
      },
      "complexity": { "noImportantStyles": "off" },
      "correctness": { "useExhaustiveDependencies": "warn" },
      "suspicious": { "noAssignInExpressions": "warn", "noArrayIndexKey": "warn" }
    }
  },
  "overrides": [
    {
      "includes": ["**", "!**/*.test.ts", "!**/*.test.tsx", "!src/test/**"],
      "linter": { "domains": { "test": "none" } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
